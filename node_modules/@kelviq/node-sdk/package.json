{
  "name": "@kelviq/node-sdk",
  "version": "2.9.0",
  "description": "Node.js SDK for interacting with the Kelviq API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npx tsc",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run clean && npm run build",
    "demo": "npx ts-node demo.ts",
    "publish:beta": "bash scripts/publish.sh --beta",
    "publish:stable": "bash scripts/publish.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelviq/kelviq-node-sdk"
  },
  "keywords": [
    "kelviq",
    "sdk",
    "api",
    "node",
    "typescript",
    "reporting",
    "checkout",
    "entitlements",
    "customers",
    "subscription"
  ],
  "author": "Kelviq <admin@kelviq.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kelviq/kelviq-node-sdk/issues"
  },
  "homepage": "https://github.com/kelviq/kelviq-node-sdk#readme",
  "dependencies": {
    "axios": "^1.6.0",
    "uuid": "^9.0.1"
  },
  "optionalDependencies": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/moxios": "^0.4.17",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "moxios": "^0.4.0",
    "nock": "^13.5.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
